{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM-Testplan Testfall",
  "description": "Schema für einen einzelnen Testfall im JSONL-Format",
  "type": "object",
  "required": ["id", "category", "prompt", "expected"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{3}[a-z]?$",
      "description": "Eindeutige Testfall-ID (z.B. hal-001, bias-002a)"
    },
    "category": {
      "type": "string",
      "enum": ["quality", "bias", "security", "code", "performance"],
      "description": "Hauptkategorie des Testfalls"
    },
    "subcategory": {
      "type": "string",
      "description": "Unterkategorie (z.B. hallucination, factual, injection)"
    },
    "language": {
      "type": "string",
      "enum": ["de", "en", "fr", "es", "it", "nl", "pl", "pt"],
      "default": "de",
      "description": "Sprache des Testfalls"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "default": "medium"
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "description": "Die eigentliche Frage / Anweisung an das Modell"
    },
    "system_prompt": {
      "type": "string",
      "description": "Optionaler System-Prompt (überschreibt den Standard)"
    },
    "context": {
      "type": "string",
      "description": "Optionaler Kontext (z.B. für RAG-Szenarien)"
    },
    "expected": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["exact", "contains", "regex", "semantic", "code_exec", "judge"],
          "description": "Art der Bewertung"
        },
        "value": {
          "type": "string",
          "description": "Erwarteter Wert oder Beschreibung für den Judge"
        },
        "alternatives": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Akzeptable alternative Antworten"
        },
        "forbidden": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Begriffe/Phrasen die NICHT in der Antwort vorkommen dürfen"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "reviewer": {"type": "string"},
        "created": {"type": "string", "format": "date"},
        "pair_id": {"type": "string", "description": "ID für gepaarte Bias-Tests"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
