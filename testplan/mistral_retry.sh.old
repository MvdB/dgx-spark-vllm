#!/bin/bash
# Wartet, bis der Hauptlauf (orchestrator --continue) die GPU freigibt, dann
# fährt es Mistral-Small-4-119B gezielt mit dem gefixten v0.26.0-Profil nach,
# kopiert den Report in die 1130-Kohorte und pusht.
set -u
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
VLLM=/home/mvdb/southbyte/southbyte-vllm
TP=$VLLM/testplan
RESULTS=/home/mvdb/southbyte/southbyte-results
PY=$TP/.venv/bin/python
COH=$TP/reports/2026-08-08_1130
CO='Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019YpS7jJGxYt9cD5nRMS7fH'
ML=$TP/mistral_retry.log
log(){ echo "[$(date '+%F %T')] $*" | tee -a "$ML"; }
push(){ local repo="$1" msg="$2"; shift 2; cd "$repo" || return
  git add "$@" 2>/dev/null
  git commit -q -m "$msg

$CO" 2>/dev/null && log "commit: $msg" || log "nichts zu committen ($repo)"
  git pull --rebase origin main >/dev/null 2>&1 || true
  git push origin main 2>&1 | tail -1 | tee -a "$ML"; }

cd "$TP"
log "=== MISTRAL-RETRY: warte auf GPU-Fenster (Hauptlauf-Ende) ==="
for i in $(seq 1 4320); do   # max 36h
  pgrep -f 'orchestrator.py --continue' >/dev/null || break
  sleep 30
done
log "GPU frei — starte Mistral-Small-4 (v0.26.0)"
$PY -u orchestrator.py --models "Mistral-Small-4,Nemotron-3-Nano-30B,Qwen3.6-35B-A3B-FP8" --continue-after-ko > "$TP/mistral_retry_run.log" 2>&1
RC=$?
log "orchestrator rc=$RC"

# frisch erzeugte Reports finden und in die Kohorte kopieren
for M in Mistral-Small-4 Nemotron-3-Nano-30B Qwen3.6-35B-A3B-FP8; do
  ND=$(ls -1dt "$TP"/reports/2026-*/ 2>/dev/null | while read d; do [ -f "$d/$M.json" ] && [ "$d" != "$COH/" ] && { echo "$d"; break; }; done)
  [ -n "$ND" ] && cp "${ND}$M.json" "$COH/$M.json" && log "Report kopiert: $M ← $ND"
done
NEW=""  # alter Ein-Modell-Block deaktiviert
if [ -n "$NEW" ] && [ -f "${NEW}Mistral-Small-4.json" ]; then
  cp "${NEW}Mistral-Small-4.json" "$COH/Mistral-Small-4.json"
  log "Report kopiert: ${NEW}Mistral-Small-4.json → Kohorte"
  # Valididätscheck
  $PY -c "import json;d=json.load(open('$COH/Mistral-Small-4.json'));pbs=d.get('playbooks',{});t=sum(len(p.get('results',[])) for p in (pbs.values() if isinstance(pbs,dict) else pbs));e=sum(1 for p in (pbs.values() if isinstance(pbs,dict) else pbs) for r in p.get('results',[]) if r.get('verdict')=='error');print(f'Mistral-Small-4: {t} Fälle, {e} error → {\"VALIDE\" if t and e/t<=0.3 else \"KAPUTT\"}')" 2>&1 | tee -a "$ML"
else
  log "KEIN Mistral-Small-4-Report erzeugt — vermutlich erneut gescheitert (siehe mistral_retry_run.log)"
fi

log "Sites neu bauen + pushen"
python3 "$TP/make_public_site.py" >>"$ML" 2>&1
push "$VLLM" "Mistral-Small-4-119B nachgezogen (v0.26.0)" docs testplan/mistral_retry.sh
python3 "$RESULTS/build_site.py" >>"$ML" 2>&1
push "$RESULTS" "Hub: Mistral-Small-4 ergänzt" build_site.py docs
log "MISTRAL_RETRY_DONE"
log "=== MISTRAL-RETRY ENDE ==="
