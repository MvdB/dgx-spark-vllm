# Testplan — Umgebungsvariablen
# Kopieren nach .env und Werte anpassen. Die .env wird nicht ins Repo commitet.

# Judge-Konfiguration
# Ohne diese Variablen wird der lokale Judge auf gb10-rack verwendet.
JUDGE_HOST=10.0.0.26          # Hostname/IP des Judge-Endpoints
JUDGE_PORT=4000               # Port (Standard: 8000 für lokales vLLM)
JUDGE_MODEL=anthropic/claude-haiku-4-5   # Modell-ID am Judge-Endpoint
JUDGE_API_KEY=***REMOVED***

# Optional: HuggingFace Token (falls Modelle von HF geladen werden)
# HF_TOKEN=hf_...
