# Testplan — Umgebungsvariablen
# Kopieren nach .env und Werte anpassen. Die .env wird nicht ins Repo commitet.

# Judge-Konfiguration
JUDGE_HOST=your-judge-host    # Hostname/IP des Judge-Endpoints (lokales vLLM oder LiteLLM-Proxy)
JUDGE_PORT=8000               # Port
JUDGE_MODEL=your-judge-model  # Modell-ID am Judge-Endpoint (z.B. anthropic/claude-haiku-4-5)
JUDGE_API_KEY=***REMOVED***

# Target-Maschine (Spark B — hier laufen die Test-Modelle)
TARGET_HOST=your-target-host

# Produktionsmaschinen (nur für HSF-Kalibrierungslauf)
PROD_HOST_A=your-prod-host-a
PROD_HOST_B=your-prod-host-b
