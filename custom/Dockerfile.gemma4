# Custom vLLM image for Gemma 4 models on DGX Spark (GB10, sm_120).
#
# Base: vllm/vllm-openai:v0.19.0
# Fix: transformers 4.57.6 does not include the gemma4 architecture.
#      Upgrading to transformers 5.x adds gemma4 support.
#
# Build:
#   docker build -t spark-gemma4:v1 -f custom/Dockerfile.gemma4 .
#
# Usage: vllm_spark.sh picks this image automatically via vllm_profile.conf.

FROM vllm/vllm-openai:v0.19.0

RUN pip install --upgrade "transformers>=5.0.0"
