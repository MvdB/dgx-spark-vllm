# Custom vLLM image für Gemma 4 NVFP4 auf DGX Spark (GB10, sm_120).
#
# Kombiniert:
#   - nvcr.io/nvidia/vllm:26.03.post1-py3: sm_120 NVFP4/compressed-tensors Kernel
#   - transformers 5.x: Gemma4-Architektur-Support
#
# Build:
#   docker build -t spark-gemma4-nvfp4:v1 -f custom/Dockerfile.gemma4-nvfp4 .
#
# Note: NVIDIA-Entrypoint macht exec "$@" → vllm_spark.sh ergänzt "vllm serve" Prefix.

FROM nvcr.io/nvidia/vllm:26.03.post1-py3

RUN pip install --upgrade "transformers>=5.0.0"
